{
  "name": "@nicodes/reindr-core",
  "version": "0.0.1",
  "description": "Shared configuration and security primitives for Reindr integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicodes/reindr.git",
    "directory": "packages/core"
  },
  "homepage": "https://reindr.dev",
  "bugs": { "url": "https://github.com/nicodes/reindr/issues" },
  "keywords": ["reindr", "generative-ui", "agent-ui"],
  "author": "Nico Zessoules",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
